# llm  = 调用真实大模型（需要 API Key）
# mock = 离线规则演示（无需 Key，仅用于跑通流程和测试）
LLM_MODE=llm

# 任意 OpenAI 兼容端点均可。下面以 DeepSeek 为例。
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 兼容别名：如果没有设置 OPENAI_*，程序会读取 DEEPSEEK_*
# DEEPSEEK_API_KEY=sk-replace-with-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 单次模型请求超时（秒）
REQUEST_TIMEOUT=90

# 允许跨域访问前端开发服务器；生产环境建议改成具体域名
CORS_ORIGINS=*
